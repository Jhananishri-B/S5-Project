# =============================================================================
# Root .gitignore for AI Accessibility Project
# =============================================================================

# Environment variables & secrets (CRITICAL)
.env*
*.env*


# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node dependencies & frontend builds
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & coverage caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
